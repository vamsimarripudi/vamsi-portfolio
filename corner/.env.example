# Copy to .env.local. Never commit real credentials.
PORT=4141
HOST=127.0.0.1
SITE_URL=http://localhost:4141
SITE_TITLE=Vamsi's Corner
SITE_TIMEZONE=Asia/Kolkata
DB_PATH=./data/corner.sqlite
ADMIN_EMAIL=owner@example.com
# Run npm run setup to generate and store a strong password hash.
ADMIN_PASSWORD_HASH=
# Optional, generated by npm run setup. Required for production.
SESSION_SECRET=
# Development sample cards are clearly marked SAMPLE and are not persisted.
DEMO_CONTENT=1
# In production use HTTPS and set TRUST_PROXY only behind an authenticating reverse proxy.
TRUST_PROXY=0

# Deployment under vamsimarripudi.me/corner
CORNER_BASE_PATH=/corner
DATA_DIR=/data

# Private Railway S3/Tigris backup. Set variables using Railway bucket references; never commit their resolved values.
CORNER_BACKUP_ENABLED=0
CORNER_BACKUP_S3_ENDPOINT=
CORNER_BACKUP_S3_BUCKET=
CORNER_BACKUP_S3_REGION=auto
CORNER_BACKUP_S3_URL_STYLE=virtual-host
CORNER_BACKUP_S3_ACCESS_KEY_ID=
CORNER_BACKUP_S3_SECRET_ACCESS_KEY=
CORNER_BACKUP_UTC_HOUR=2
CORNER_BACKUP_UTC_MINUTE=30
CORNER_BACKUP_RETENTION_DAYS=30

# Corner V2 identity. Public registration stays OFF until a verified sender is configured.
CORNER_AUTH_REGISTRATION_ENABLED=0
CORNER_AUTH_RESEND_API_KEY=
# Verified Resend sender (Railway environment value; do not add literal surrounding quotes).
CORNER_AUTH_FROM_EMAIL=
# Local integration tests ONLY: NODE_ENV=test + disposable file; never use on production.
CORNER_AUTH_TEST_OUTBOX=

# V3 reader engagement - opt-in flags; all disabled until acceptance tests
CORNER_V3_SEARCH=0
CORNER_V3_GUESTBOOK=0
CORNER_V3_FOLLOW=0
# Stable independent secret (32+ characters), required before enabling email following.
CORNER_V3_FOLLOW_KEY=
CORNER_V3_READING=0

# V3 Phase 2 - private Studio and public memories, staged OFF until accepted
CORNER_V3_MEMORIES=0

# V3 Phase 3 Wishes Studio. Default OFF; drafts and schedules do not send email.
CORNER_V3_WISHES=0
# Requires verified double-opt-in followers, stable follow key, and verified Resend sender.
CORNER_V3_WISH_DELIVERY=0
