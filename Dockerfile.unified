FROM node:22.16.0-bookworm-slim
WORKDIR /srv/portfolio
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY corner/package.json corner/package.json
RUN npm --prefix corner install --omit=dev --no-audit --no-fund --package-lock=false
COPY . .
RUN node --check corner/src/unified-dispatch.mjs && node --check corner/src/unified-maintenance.mjs && node --check corner/src/server.mjs
RUN mkdir -p /data && chown -R node:node /srv/portfolio /data
ENV NODE_ENV=production
ENV PORT=4141
ENV HOST=0.0.0.0
ENV DATA_DIR=/data
ENV CORNER_BASE_PATH=/corner
ENV SITE_URL=https://vamsimarripudi.me/corner
ENV UNIFIED_PORTFOLIO_API=0
EXPOSE 4141
CMD ["sh", "-c", "chown node:node /data && exec su -s /bin/sh node -c 'node --no-warnings corner/src/server.mjs'"]
